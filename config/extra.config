# ===========================================================================
# 逃生口 / 零散开关 —— 最后被追加进 openwrt/.config，优先级最高
#
# packages.txt 只能表达「包开/关」，其它任何 CONFIG_* 都写在这里。
# 同样是 =数字/字符串 的行不能带行尾注释。
# 全部注释状态即「什么都不改」。
# ===========================================================================

# ----- 关掉 IPv6（旁路由/单栈网络的常见需求）-----
# CONFIG_IPV6=n

# ----- 默认主题换成 argon（luci feed 里有，但默认集合是 bootstrap）-----
# CONFIG_PACKAGE_luci-theme-argon=y
# CONFIG_PACKAGE_luci-theme-bootstrap=n

# ----- 关掉不用的默认包，缩体积（体积大就先从这里砍）-----
# CONFIG_PACKAGE_luci-app-vsftpd=n
# CONFIG_PACKAGE_luci-app-vlmcsd=n
# CONFIG_PACKAGE_luci-app-nlbwmon=n
# CONFIG_PACKAGE_luci-app-accesscontrol=n
# CONFIG_PACKAGE_luci-app-wol=n
# CONFIG_PACKAGE_luci-app-filetransfer=n

# ----- 打包额外的内核模块（举例：USB 网卡 / 无线网卡）-----
# CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

# ----- 固件里的其它细节 -----
# CONFIG_TARGET_MULTI_PROFILE 之类不要开，会顶满 6 小时上限
