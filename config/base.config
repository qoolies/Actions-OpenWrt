# ===========================================================================
# 机型 / 分区 / 镜像格式 —— 「机器属性」，很少改
#
# 这个文件由 scripts/gen-config.sh 读入，最终拼成 openwrt/.config。
# 换机型只需改这里（配合 config/packages.txt 里的包）。
#
# 写法要点（踩过的坑）：
#   =y / =n 行，Kconfig 只看第一个字符，行尾写注释也无害；
#   =数字 / =字符串 行是整串校验，行尾绝不能写注释（会判定值非法而丢弃）。
#   所以下面数字行的说明一律单独写一行。
# ===========================================================================

# ----- x86_64 generic（PVE 虚拟机 / 软路由）-----
# 换别的平台就替换这三行，比如 arm64 软路由：
#   CONFIG_TARGET_rockchip=y
#   CONFIG_TARGET_rockchip_armv8=y
#   CONFIG_TARGET_rockchip_armv8_DEVICE_r2s=y
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ----- 镜像格式 -----
# squashfs 只读根 + overlay，PVE 里 qm importdisk 直接用
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 产出 .img.gz（不压缩就只有一个 2048M 的 .img，传得慢）
CONFIG_TARGET_IMAGES_GZIP=y
# 额外要 ext4 根（可选，装上会多出一份镜像）
# CONFIG_TARGET_ROOTFS_EXT4FS=y

# ----- 分区大小（单位 MB，数字行请不要加行尾注释）-----
# boot 分区 32M：6.12+ 内核默认 16M 容易塞不下
CONFIG_TARGET_KERNEL_PARTSIZE=32
# 根分区 2048M≈2G；要装 docker/大插件就加到 4096
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ----- 编译加速 -----
# 配合 workflow 里的 actions/cache，第二次起只重编改动部分
CONFIG_CCACHE=y

# ----- 可选：把 .config 里所有可选包都打开（千万别开）-----
# CONFIG_ALL=y
