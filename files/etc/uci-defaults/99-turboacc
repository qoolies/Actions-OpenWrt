#!/bin/sh
#
# File: files/etc/uci-defaults/99-turboacc
# Description: 首次启动时把「网络 → 防火墙 → 常规设置」里的加速项设成默认值
#
# 上游已把 TurboACC 并进了防火墙页面（luci-app-turboacc 于 2026-10-29 从
# luci@openwrt-25.12 移除），页面上这几项就是老 TurboACC 的开关：
#   fullcone            1 = FULLCONENAT（走 kmod-nft-fullcone）
#                       2 = Broadcom Fullcone NAT1（走内核补丁的 masquerade fullcone）
#   fullcone6           IPv6 全锥形 NAT，家用一般不需要，默认关
#   tcpcca              bbr / cubic / reno，对应 kmod-tcp-bbr
#   flow_offloading     软件流量卸载，对应 kmod-nft-offload
#   flow_offloading_hw  硬件卸载：x86 没有卸载单元，保持关
#
# uci-defaults 在首次启动、各服务启动之前跑一次，跑完自己标记完成（不会重复执行），
# 之后在 LuCI 里改的值不会被覆盖。

[ -f /etc/config/firewall ] || exit 0

uci -q batch <<EOF
set firewall.@defaults[0].fullcone='1'
set firewall.@defaults[0].fullcone6='0'
set firewall.@defaults[0].tcpcca='bbr'
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='0'
commit firewall
EOF

exit 0
