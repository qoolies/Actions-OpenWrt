# ---------------------------------------------------------------------------
# x86_64 软路由 / PVE 云编译配置
# 编译源：coolsnowwolf/lede@master（luci feed = openwrt-25.12 分支）
# 更新：2026-11-11
#
# 写法要点：
#   1. 本文件只写「与 lede 默认不同」的部分。lede 的 DEFAULT_PACKAGES.router
#      已经默认编入一批插件（ddns / upnp / autoreboot / arpbind / filetransfer
#      / vsftpd / wol / vlcmsd / nlbwmon / accesscontrol / turboacc / ssr-plus
#      + luci-theme-design），这里不重复写，也就不需要逐条 confirm。
#   2. =y 行 Kconfig 只看首字符，行尾注释无害；
#      =数字 / =字符串 行是整串校验，不能带行尾注释。
# ---------------------------------------------------------------------------

# ===== 目标平台：x86_64 generic（PVE 虚拟机 / 软路由）=====
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ===== 镜像格式：squashfs + gzip（PVE 用 img.gz 导入）=====
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ===== 显式关闭：lede 默认会装进来，但你不要 =====
# ssr-plus 由 DEFAULT_PACKAGES.router 默认选中（包来自 fw876/helloworld feed）。
# 只要 openclash，关掉它，免得多一个会抢 DNS / 占端口的代理面板。
# CONFIG_PACKAGE_luci-app-ssr-plus is not set

# ===== 显式加入：科学上网 =====
# luci feed@openwrt-25.12 自带 luci-app-openclash，无需追加任何 feed
CONFIG_PACKAGE_luci-app-openclash=y

# ===== 显式加入：去广告 + DNS =====
# adguardhome 本体在 packages feed，luci 界面在 luci feed，两个都要
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y

# ===== 显式加入：运维 =====
# 不加 luci-app-ttyd：ttyd 是「浏览器里开终端」，和你已有 SSH 功能重复。
# lede 默认的 dropbear 已经提供 SSH（22 端口），命令行访问走它就行。
# PVE 用 virtio 网卡时用得上；若内核已内建该驱动，本行会被 make defconfig
# 丢弃并出现在「被丢弃」报告里 —— 属正常，不影响使用。
CONFIG_PACKAGE_kmod-virtio-net=y

# ---------------------------------------------------------------------------
# 已知拿不到、不要打开的符号（feed 里没有，写了只会进「被丢弃」报告）：
#   luci-app-turboacc        25.12 分支已移除（但 lede 默认清单仍引用它）
#   luci-app-accesscontrol   25.12 分支已移除（同上）
#   luci-app-tailscale       luci feed 无此包，只有 tailscale 本体
#   luci-app-store           iStore 非标准 feed 布局，需 diy-part1.sh 摊平
#
# 内核驱动也不用写：x86 的 DEFAULT_PACKAGES 已含 kmod-igc / kmod-e1000e /
# kmod-r8168 / kmod-r8125 / kmod-vmxnet3 / kmod-tg3 等常见网卡。
# ---------------------------------------------------------------------------
