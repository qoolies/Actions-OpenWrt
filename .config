# ---------------------------------------------------------------------------
# x86_64 软路由 / PVE 云编译配置（精简版 .config）
# 
# ---------------------------------------------------------------------------

# ===== 目标平台 =====
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ===== 镜像格式：squashfs + gzip（PVE 用 img.gz） =====
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ===== 网卡驱动（Intel i225/i226 2.5G + 常见千兆 + PVE VirtIO） =====
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-virtio-net=y

# ===== 预装插件（均已在当前 lede 默认 feed 中核实存在） =====
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-theme-argon=y

# ===== Tailscale 本体（packages feed 有；LuCI 界面 25.12 feed 里没有） =====
CONFIG_PACKAGE_tailscale=y

# ---------------------------------------------------------------------------
# 下面三项请先在 Actions 里跑一次，看「配置解析报告」再决定要不要打开：
#   CONFIG_PACKAGE_luci-app-store      iStore 不在 lede 默认 feed 里（见 REVIEW.md 第 3 节）
#   CONFIG_PACKAGE_luci-app-turboacc   25.12 分支已移除，24.10 分支还有
#   CONFIG_PACKAGE_luci-app-tailscale  luci feed 里没有这个名字
# 打开时把下面目标行的行首 # 去掉即可（注意：行首 '#' 开头是合法注释）。
#
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-tailscale=y
# ---------------------------------------------------------------------------
