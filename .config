# This is an empty file, please overwrite it after generating the .config file with the source code
# 确保目标架构是 x86_64
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# 编译格式：输出 img.gz (极度方便 PVE 导入)
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# 必备网卡驱动 (Intel 2.5G 网卡 i225/i226 + PVE VirtIO 虚拟网卡)
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-virtio-net=y

#预装插件
CONFIG_PACKAGE_luci-app-store=y          # iStore 应用商店
CONFIG_PACKAGE_luci-app-adguardhome=y     # AdGuard Home 去广告
CONFIG_PACKAGE_luci-app-openclash=y       # Clash 代理
CONFIG_PACKAGE_luci-app-ttyd=y            # 网页 TTYD 终端
CONFIG_PACKAGE_luci-app-tailscale=y       # Tailscale 异地组网/内网穿透
CONFIG_PACKAGE_luci-app-turboacc=y        # Turbo ACC 网络加速
CONFIG_PACKAGE_luci-app-diskman=y         # DiskMan 磁盘管理
CONFIG_PACKAGE_luci-theme-argon=y         # Argon 主题
